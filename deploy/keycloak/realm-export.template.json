{
  "realm": "hr360",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "smtpServer": {
    "host": "__SMTP_HOST__",
    "port": "__SMTP_PORT__",
    "from": "__SMTP_FROM_ADDRESS__",
    "fromDisplayName": "HR360",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "organizationsEnabled": true,
  "roles": {
    "realm": [
      { "name": "employee", "description": "Standart çalışan" },
      { "name": "manager", "description": "Departman yöneticisi" },
      { "name": "accounting", "description": "Muhasebe / bordro uzmanı" },
      { "name": "hr-admin", "description": "İK yöneticisi" },
      { "name": "tenant-admin", "description": "Şirket yöneticisi" },
      { "name": "platform-admin", "description": "Platform süper yöneticisi" }
    ]
  },
  "clients": [
    {
      "clientId": "hr360-web",
      "publicClient": true,
      "protocol": "openid-connect",
      "enabled": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["__PUBLIC_ORIGIN__/*"],
      "webOrigins": ["__PUBLIC_ORIGIN__"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "__PUBLIC_ORIGIN__/*"
      }
    },
    {
      "clientId": "hr360-ml-inference",
      "publicClient": false,
      "protocol": "openid-connect",
      "enabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "secret": "__ML_KEYCLOAK_CLIENT_SECRET__"
    }
  ],
  "users": [
    {
      "username": "demo.admin",
      "email": "demo.admin@hr360.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "__DEMO_ADMIN_PASSWORD__", "temporary": false }
      ],
      "realmRoles": ["tenant-admin"]
    },
    {
      "username": "platform.admin",
      "email": "platform.admin@hr360.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Platform",
      "lastName": "Yonetici",
      "credentials": [
        { "type": "password", "value": "__PLATFORM_ADMIN_PASSWORD__", "temporary": false }
      ],
      "realmRoles": ["platform-admin"]
    }
  ]
}
