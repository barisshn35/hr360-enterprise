# Bu dosyayi elle doldurmaniza gerek yok — ./install.sh calistirin, sizin
# icin sorar/uretir ve .env dosyasini yazar. Referans olsun diye burada
# hangi degiskenlerin kullanildigi listeleniyor.

# Erisim
GATEWAY_PORT=80
PUBLIC_URL=http://localhost
# Tarayicida kullanilan tam koken (sema + alan adi [+ port]). Keycloak'in genel
# adresi ve servislerin bekledigi jeton ureticisi (issuer) buradan uretilir.
PUBLIC_ORIGIN=http://localhost

# PostgreSQL (hr360admin kullanicisi)
HR360_DB_PASSWORD=

# Keycloak master admin
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Kiracilarin SMTP parolalarini sifreleyen AES-256 anahtari (tenant-service ve
# notification-service). base64 kodlu tam 32 byte olmali: openssl rand -base64 32
# Kurulumdan sonra degistirilirse kayitli SMTP parolalari cozulemez.
TENANT_SECRET_KEY=

# MinIO (S3 uyumlu nesne depolama) root kimlik bilgileri
MINIO_ROOT_USER=hr360minio
MINIO_ROOT_PASSWORD=

# ml-inference servisinin Keycloak'a kendini tanittigi client secret
ML_KEYCLOAK_CLIENT_SECRET=

# Demo sirketinin yoneticisi (demo.admin, yalnizca tenant-admin)
DEMO_ADMIN_PASSWORD=
# Platform yoneticisi (platform.admin; tum kiracilar, plan degistirme, askiya alma)
PLATFORM_ADMIN_PASSWORD=

# E-posta. install.sh sorar; ayni ayar Keycloak realm'ine de (davet / parola
# e-postalari) yazilir. Yalnizca burayi degistirmek Keycloak'i guncellemez.
# SMTP_HOST=mailpit = paketteki test kutusu, gercek gonderim yapmaz.
SMTP_HOST='mailpit'
SMTP_PORT=1025
SMTP_USER='hr360'
SMTP_PASSWORD='hr360'
SMTP_FROM_ADDRESS='noreply@hr360.local'
SMTP_FROM_NAME='HR360'

# Keycloak yonetim paneli erisimi - scripts/keycloak-admin-access.sh yonetir.
# open | ip | port
KEYCLOAK_ADMIN_MODE=open
# ip/port modunda izinli IP/CIDR'ler (virgulle)
KEYCLOAK_ADMIN_ALLOWED_IPS=
# port modunda 0.0.0.0
KEYCLOAK_ADMIN_BIND=127.0.0.1
KEYCLOAK_ADMIN_PORT=8090
# port modunda yonetim konsolunun adresi
KEYCLOAK_ADMIN_URL=

# HTTPS - scripts/tls.sh yonetir.
# HTTPS acikken 0.0.0.0
GATEWAY_TLS_BIND=127.0.0.1
GATEWAY_TLS_PORT=443
# bos | letsencrypt | certificate | self-signed | external
TLS_MODE=
# Virgullu liste: "letsencrypt" (scripts/tls.sh, certbot yenileme servisi),
# "monitoring" (scripts/monitoring.sh, Prometheus + Grafana + Loki).
COMPOSE_PROFILES=

# Izleme - scripts/monitoring.sh yonetir.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
# Alarm kanallari - scripts/monitoring.sh alerts ... yonetir.
# E-posta SMTP_* ayarlariyla gider (Microsoft 365: SMTP_HOST=smtp.office365.com, SMTP_PORT=587).
ALERT_EMAIL_TO=
ALERT_SLACK_WEBHOOK_URL=
# Teams kanali > Workflows > "Post to a channel when a webhook request is received"
ALERT_TEAMS_WEBHOOK_URL=
ALERT_TIMEZONE=Europe/Istanbul
ALERTMANAGER_PORT=9093

# HR360 acik kaynaktir: varsayilan olarak tum kiracilar tum modulleri kullanir.
# Ticari (SaaS) isletim icin:
#   PLAN_ENFORCEMENT=true  -> moduller kiracinin planina (Trial/Standard/Enterprise) gore kisitlanir
#   BILLING_ENABLED=true   -> abonelik ekrani ve aylik fatura uretimi (odeme saglayicisi entegrasyonu yok)
PLAN_ENFORCEMENT=false
BILLING_ENABLED=false
